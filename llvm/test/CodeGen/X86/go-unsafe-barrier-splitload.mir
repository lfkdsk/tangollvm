# RUN: llc -start-after=prologepilog -filetype=obj -go-debug-unsafe-point %s -o %t.o 2>&1 | not grep 'Go unsafe-point barrier fallback: splitload'
# RUN: %python %S/Inputs/go_unsafe_dump.py %t.o splitload | FileCheck %s
# RUN: sed 's/@runtime.writeBarrier,/@runtime.writeBarrier + 4,/' %s | llc -x=mir -start-after=prologepilog -filetype=obj -go-debug-unsafe-point -o %t.fallback.o 2>&1 | grep 'Go unsafe-point barrier fallback: splitload'
# REQUIRES: x86-registered-target
#
# UP3: ThinLTO can split the write-barrier enabled check across blocks — a
# MOV32rm load of runtime.writeBarrier in a predecessor feeds a TEST32rr in
# the actual check block. The reverse barrier search must recognize the load
# form (mayLoad, global at operand 4), otherwise it walks past the check to
# the entry block and takes the whole-function barrier-search fallback.
# With the check recognized only the barrier region is -2; the entry and
# return blocks stay preemptible (-1). The +4 sed variant is a non-enable
# reference and keeps the conservative fallback.

# CHECK: splitload: [0, {{[0-9]+}}) -2
# CHECK: splitload: [{{[0-9]+}}, {{[0-9]+}}) -1
# CHECK-NOT: splitload: [0, {{[0-9]+}}) -1
--- |
  target triple = "x86_64-unknown-linux-goabi"
  @runtime.writeBarrier = external global i32
  declare cc 113 ptr @runtime.gcWriteBarrier2()
  define cc 113 void @splitload() #0 !dbg !4 !go.funcinfo !0 { ret void }
  attributes #0 = { "go-leaf"="true" "go-no-split"="true" "go-no-frame-checked"="true" }
  !go.version = !{!7}
  !llvm.module.flags = !{!1}
  !llvm.dbg.cu = !{!2}
  !0 = !{i32 0, i8 0, i8 0, i32 1}
  !1 = !{i32 2, !"Debug Info Version", i32 3}
  !2 = distinct !DICompileUnit(language: DW_LANG_Go, file: !3, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "splitload.go", directory: "/")
  !4 = distinct !DISubprogram(name: "splitload", scope: !3, file: !3, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !2)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !{!"go1.22.12"}
...
---
name: splitload
tracksRegLiveness: true
frameInfo:
  stackSize: 8
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.1
    JMP_1 %bb.1
  bb.1:
    successors: %bb.2
    liveins: $rax
    $eax = MOV32rm $rip, 1, $noreg, target-flags(x86-gotpcrel) @runtime.writeBarrier, $noreg
    JMP_1 %bb.2
  bb.2:
    successors: %bb.3, %bb.7
    liveins: $eax, $rax
    TEST32rr killed $eax, $eax, implicit-def $eflags
    JCC_1 %bb.7, 4, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.7
    liveins: $rax
    MOV64mr $rsp, 1, $noreg, 0, $noreg, $rax
    CALL64pcrel32 @runtime.gcWriteBarrier2, csr_64_allregs_nor11_nosse, implicit $rsp, implicit-def $r11
    JMP_1 %bb.7
  bb.7:
    successors: %bb.8, %bb.9
    liveins: $rax
    $rax = ADD64ri8 $rax, 1, implicit-def dead $eflags
    CMP32ri $eax, 0, implicit-def $eflags
    JCC_1 %bb.9, 5, implicit $eflags
    JMP_1 %bb.8
  bb.8:
    successors: %bb.9
    $eax = MOV32ri 1
    JMP_1 %bb.9
  bb.9:
    RET 0
...
