# RUN: llc -start-after=prologepilog -filetype=obj %s -o %t.o
# RUN: %python %S/Inputs/go_unsafe_dump.py %t.o morestack_retry_selfloop | FileCheck %s --check-prefix=SELF
# RUN: %python %S/Inputs/go_unsafe_dump.py %t.o morestack_retry_diff_check | FileCheck %s --check-prefix=DIFF
# RUN: llvm-objdump -d %t.o | FileCheck %s --check-prefix=CODE
# REQUIRES: x86-registered-target

# A tail-duplicated morestack retry self-loop in the cold block is recognized
# like the normal prologue check: the entry compare and the whole cold retry
# block stay async-unsafe (-2), but the function body is preemptible (-1)
# instead of triggering the whole-function fallback.
#
# The negative control keeps the same SP-consistent CFG but the repeated
# compare in the cold block is not identical to the entry check (different
# stackguard displacement), so the retry shape is not recognized and the
# conservative whole-function -2 policy remains.

# SELF:      morestack_retry_selfloop: [0, 9) -1
# SELF-NEXT: morestack_retry_selfloop: [9, 28) -2
# SELF-NEXT: morestack_retry_selfloop: [28, 50) -1
# DIFF:      morestack_retry_diff_check: [0, 50) -2
# DIFF-NOT:  morestack_retry_diff_check:.* -1

# CODE-LABEL: <morestack_retry_selfloop>:
# CODE:       callq
# CODE:       jbe 0xb
# CODE-LABEL: <morestack_retry_diff_check>:
# CODE:       callq

--- |
  target triple = "x86_64-unknown-linux-goabi"
  define cc 113 void @morestack_retry_selfloop() #0 !dbg !4 !go.funcinfo !0 { ret void }
  define cc 113 void @morestack_retry_diff_check() #0 !dbg !8 !go.funcinfo !0 { ret void }
  attributes #0 = { "go-split"="true" "go.stack.size.type"="middle" "go-no-frame-checked"="false" }
  !go.version = !{!7}
  !llvm.module.flags = !{!1}
  !llvm.dbg.cu = !{!2}
  !0 = !{i32 0, i8 0, i8 0, i32 1}
  !1 = !{i32 2, !"Debug Info Version", i32 3}
  !2 = distinct !DICompileUnit(language: DW_LANG_Go, file: !3, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "retry.go", directory: "/")
  !4 = distinct !DISubprogram(name: "morestack_retry_selfloop", scope: !3, file: !3, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !2)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !{!"go1.22.12"}
  !8 = distinct !DISubprogram(name: "morestack_retry_diff_check", scope: !3, file: !3, line: 10, type: !5, spFlags: DISPFlagDefinition, unit: !2)
...
---
name: morestack_retry_selfloop
tracksRegLiveness: true
frameInfo:
  stackSize: 168
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    $r12 = LEA64r $rsp, 1, $noreg, -40, $noreg
    CMP64rm $r12, $r14, 1, $noreg, 16, $noreg, implicit-def $eflags
    JCC_1 %bb.2, 6, implicit $eflags
  bb.1:
    frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
    $rbp = frame-setup MOV64rr $rsp
    $rsp = frame-setup SUB64ri32 $rsp, 160, implicit-def dead $eflags
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags, implicit-def $rax
    $rsp = frame-destroy ADD64ri32 $rsp, 160, implicit-def dead $eflags
    $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    RET64
  bb.2:
    successors: %bb.2, %bb.1
    NOOP
    CALL64pcrel32 &runtime.morestack_noctxt, implicit $rsp, implicit $ssp
    $r12 = LEA64r $rsp, 1, $noreg, -40, $noreg
    CMP64rm $r12, $r14, 1, $noreg, 16, $noreg, implicit-def $eflags
    JCC_1 %bb.1, 7, implicit $eflags
    JMP_1 %bb.2
...
---
name: morestack_retry_diff_check
tracksRegLiveness: true
frameInfo:
  stackSize: 168
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    $r12 = LEA64r $rsp, 1, $noreg, -40, $noreg
    CMP64rm $r12, $r14, 1, $noreg, 16, $noreg, implicit-def $eflags
    JCC_1 %bb.2, 6, implicit $eflags
  bb.1:
    frame-setup PUSH64r killed $rbp, implicit-def $rsp, implicit $rsp
    $rbp = frame-setup MOV64rr $rsp
    $rsp = frame-setup SUB64ri32 $rsp, 160, implicit-def dead $eflags
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags, implicit-def $rax
    $rsp = frame-destroy ADD64ri32 $rsp, 160, implicit-def dead $eflags
    $rbp = frame-destroy POP64r implicit-def $rsp, implicit $rsp
    RET64
  bb.2:
    successors: %bb.2, %bb.1
    NOOP
    CALL64pcrel32 &runtime.morestack_noctxt, implicit $rsp, implicit $ssp
    $r12 = LEA64r $rsp, 1, $noreg, -40, $noreg
    CMP64rm $r12, $r14, 1, $noreg, 24, $noreg, implicit-def $eflags
    JCC_1 %bb.1, 7, implicit $eflags
    JMP_1 %bb.2
...
