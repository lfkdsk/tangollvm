# RUN: llc -start-after=prologepilog -filetype=obj -go-debug-unsafe-point %s -o %t.o 2>&1 | FileCheck %s
# REQUIRES: x86-registered-target
#
# Both flag loads need their successor regions protected. Marking bb.1
# unsafe as a successor of bb.0 must not suppress its own fallback.
# CHECK: GO-GC-STATS unsafe-block probe 2 1 1
#
--- |
  target triple = "x86_64-unknown-linux-goabi"
  @runtime.writeBarrier = external global i32
  declare cc 113 ptr @runtime.gcWriteBarrier2()
  define cc 113 void @probe() #0 !dbg !4 !go.funcinfo !0 { ret void }
  attributes #0 = { "go-leaf"="true" "go-no-split"="true" "go-no-frame-checked"="true" }
  !go.version = !{!7}
  !llvm.module.flags = !{!1}
  !llvm.dbg.cu = !{!2}
  !0 = !{i32 0, i8 0, i8 0, i32 1}
  !1 = !{i32 2, !"Debug Info Version", i32 3}
  !2 = distinct !DICompileUnit(language: DW_LANG_Go, file: !3, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "probe.go", directory: "/")
  !4 = distinct !DISubprogram(name: "probe", scope: !3, file: !3, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !2)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !{!"go1.26.4"}
...
---
name: probe
tracksRegLiveness: true
frameInfo:
  stackSize: 0
body: |
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $rax
    CMP32mi $rip, 1, $noreg, @runtime.writeBarrier, $noreg, 0, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.2, %bb.3
    liveins: $rax
    CMP32mi $rip, 1, $noreg, @runtime.writeBarrier, $noreg, 0, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    successors: %bb.3
    liveins: $rax
    MOV64mr $rsp, 1, $noreg, 0, $noreg, $rax
  bb.3:
    RET 0
...
