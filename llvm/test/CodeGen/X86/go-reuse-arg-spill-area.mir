# RUN: llc -run-pass=x86-go-fixup-postregalloc -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -run-pass=x86-go-fixup-postregalloc -go-reuse-arg-spill-area=false %s -o - | FileCheck %s --check-prefix=OFF

--- |
  target triple = "x86_64-unknown-linux-goabi"
  declare void @callee()
  !9 = !{i64 0, i64 8, i64 -1, i64 16, i64 8, i64 0}
  define cc 113 void @reuse() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @copy_chain() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @redefined() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @two_stores() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @too_wide() gc "go" !go.caller.args.area !4 { ret void }
  define cc 113 void @no_frame() "go-no-frame-checked"="true" gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @address_taken() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @alloca_slot() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @float_arg() gc "go" !go.caller.args.area !9 { ret void }
  define cc 113 void @branch_spill() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @clobbered_path() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @join_spill() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @overlapping_fixed() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @loop_backedge() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @join_copy_both() gc "go" !go.caller.args.area !8 { ret void }
  define cc 113 void @deep_diamond() gc "go" !go.caller.args.area !8 { ret void }
  !8 = !{i64 0, i64 8, i64 2, i64 16, i64 8, i64 1}
  !4 = !{i64 0, i64 8, i64 2, i64 16, i64 4, i64 0}
...
# CHECK-LABEL: name: reuse
# CHECK: fixedStack:
# CHECK: offset: 8, size: 8, alignment: 8
# CHECK: stack:           []
# CHECK: MOV64mr %fixed-stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %fixed-stack.0)
# CHECK: STATEPOINT 0, 0, 0, @callee, 2, 0, 2, 0, 2, 1, 1, 8, %fixed-stack.0, 0{{.*}}(load (s64) from %fixed-stack.0)
# CHECK: $rax = MOV64rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.0)
# OFF-LABEL: name: reuse
# OFF: MOV64mr %stack.0
---
name: reuse
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    STATEPOINT 0, 0, 0, @callee, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 0, 2, 0, csr_64, implicit-def $rsp, implicit-def $ssp :: (load (s64) from %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: copy_chain
# CHECK: MOV64mr %fixed-stack.0{{.*}}$r10
---
name: copy_chain
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    $r10 = MOV64rr $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $r10 :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: redefined
# CHECK: MOV64mr %stack.0
---
name: redefined
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    $ebx = MOV32ri 1
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: two_stores
# CHECK: MOV64mr %fixed-stack.0
# CHECK: MOV64mr %fixed-stack.0
---
name: two_stores
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
