# CHECK: MOV64mr %stack.0
---
name: too_wide
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: no_frame
# CHECK: MOV64mr %stack.0
---
name: no_frame
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: address_taken
# CHECK: MOV64mr %stack.0
---
name: address_taken
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rcx = LEA64r %stack.0, 1, $noreg, 0, $noreg
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: alloca_slot
# CHECK: MOV64mr %stack.0
---
name: alloca_slot
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: default, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: float_arg
# CHECK: MOVSDmr %fixed-stack.0, 1, $noreg, 0, $noreg, $xmm0 :: (store (s64) into %fixed-stack.0)
# CHECK: $xmm1 = MOVSDrm_alt %fixed-stack.0
---
name: float_arg
tracksRegLiveness: true
liveins:
  - { reg: '$xmm0' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $xmm0
    MOVSDmr %stack.0, 1, $noreg, 0, $noreg, $xmm0 :: (store (s64) into %stack.0)
    $xmm1 = MOVSDrm_alt %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: branch_spill
# CHECK: MOV64mr %fixed-stack.0
---
name: branch_spill
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $rbx
    JMP_1 %bb.1

  bb.1:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: clobbered_path
# CHECK: MOV64mr %stack.0
---
name: clobbered_path
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $rbx
    $ebx = MOV32ri 1
    JMP_1 %bb.1

  bb.1:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: join_spill
# CHECK: MOV64mr %fixed-stack.0
---
name: join_spill
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rbx
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    JMP_1 %bb.2

  bb.2:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: overlapping_fixed
# CHECK: MOV64mr %stack.0
---
name: overlapping_fixed
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
fixedStack:
  - { id: 0, type: default, offset: 8, size: 8, alignment: 8 }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: loop_backedge
# CHECK: MOV64mr %stack.0
---
name: loop_backedge
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $rbx
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    JCC_1 %bb.3, 4, implicit undef $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.1
    JMP_1 %bb.1

  bb.3:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: join_copy_both
# CHECK: MOV64mr %fixed-stack.0{{.*}}$r10
---
name: join_copy_both
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rbx
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3
    liveins: $rbx
    $r10 = MOV64rr $rbx
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3
    liveins: $rbx
    $r10 = MOV64rr $rbx
    JMP_1 %bb.3

  bb.3:
    liveins: $r10
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $r10 :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
# CHECK-LABEL: name: deep_diamond
# CHECK: MOV64mr %fixed-stack.0
---
name: deep_diamond
tracksRegLiveness: true
liveins:
  - { reg: '$rbx' }
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rbx
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3
    JMP_1 %bb.3

  bb.3:
    successors: %bb.4, %bb.5
    JCC_1 %bb.5, 4, implicit undef $eflags
    JMP_1 %bb.4

  bb.4:
    successors: %bb.6
    JMP_1 %bb.6

  bb.5:
    successors: %bb.6
    JMP_1 %bb.6

  bb.6:
    successors: %bb.7, %bb.8
    JCC_1 %bb.8, 4, implicit undef $eflags
    JMP_1 %bb.7

  bb.7:
    successors: %bb.9
    JMP_1 %bb.9

  bb.8:
    successors: %bb.9
    JMP_1 %bb.9

  bb.9:
    successors: %bb.10, %bb.11
    JCC_1 %bb.11, 4, implicit undef $eflags
    JMP_1 %bb.10

  bb.10:
    successors: %bb.12
    JMP_1 %bb.12

  bb.11:
    successors: %bb.12
    JMP_1 %bb.12

  bb.12:
    successors: %bb.13, %bb.14
    JCC_1 %bb.14, 4, implicit undef $eflags
    JMP_1 %bb.13

  bb.13:
    successors: %bb.15
    JMP_1 %bb.15

  bb.14:
    successors: %bb.15
    JMP_1 %bb.15

  bb.15:
    successors: %bb.16, %bb.17
    JCC_1 %bb.17, 4, implicit undef $eflags
    JMP_1 %bb.16

  bb.16:
    successors: %bb.18
    JMP_1 %bb.18

  bb.17:
    successors: %bb.18
    JMP_1 %bb.18

  bb.18:
    successors: %bb.19, %bb.20
    JCC_1 %bb.20, 4, implicit undef $eflags
    JMP_1 %bb.19

  bb.19:
    successors: %bb.21
    JMP_1 %bb.21

  bb.20:
    successors: %bb.21
    JMP_1 %bb.21

  bb.21:
    successors: %bb.22, %bb.23
    JCC_1 %bb.23, 4, implicit undef $eflags
    JMP_1 %bb.22

  bb.22:
    successors: %bb.24
    JMP_1 %bb.24

  bb.23:
    successors: %bb.24
    JMP_1 %bb.24

  bb.24:
    liveins: $rbx
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rbx :: (store (s64) into %stack.0)
    $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET 0
...
