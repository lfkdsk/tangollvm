# RUN: llc -start-after=prologepilog -filetype=obj %s -o %t.o
# RUN: %python %S/Inputs/go_unsafe_dump.py %t.o barrier_succ_tail | FileCheck %s --check-prefix=TAIL
# RUN: %python %S/Inputs/go_unsafe_dump.py %t.o barrier_succ_load_tail | FileCheck %s --check-prefix=LOAD
# RUN: llvm-objdump -d %t.o | FileCheck %s --check-prefix=CODE
# REQUIRES: x86-registered-target

# In a barrier join block reached from both the enabled-flag fast path and the
# gcWriteBarrier slow path, the -2 region ends right after the last protected
# pointer store, so the following integer compare + branch are async-safe
# (-1). The negative control has a memory load after that store, so the whole
# join block stays -2.

# TAIL:      barrier_succ_tail: [0, 33) -2
# TAIL-NEXT: barrier_succ_tail: [33, 46) -1
# LOAD:      barrier_succ_load_tail: [0, 35) -2
# LOAD-NEXT: barrier_succ_load_tail: [35, 39) -1

# CODE-LABEL: <barrier_succ_tail>:
# CODE:       callq
# CODE:       movq %rdi, (%rsi,%r10)
# CODE-NEXT:  cmpq $0x7fffffff, %r9
# CODE-LABEL: <barrier_succ_load_tail>:
# CODE:       movq %rdi, (%rsi,%r10)
# CODE-NEXT:  cmpq $0x0, (%rsi)

--- |
  target triple = "x86_64-unknown-linux-goabi"
  @runtime.writeBarrier = external global i32
  declare cc 113 ptr @runtime.gcWriteBarrier2()
  define cc 113 void @barrier_succ_tail() #0 !dbg !4 !go.funcinfo !0 { ret void }
  define cc 113 void @barrier_succ_load_tail() #0 !dbg !8 !go.funcinfo !0 { ret void }
  attributes #0 = { "go-leaf"="true" "go-no-split"="true" "go-no-frame-checked"="true" }
  !go.version = !{!7}
  !llvm.module.flags = !{!1}
  !llvm.dbg.cu = !{!2}
  !0 = !{i32 0, i8 0, i8 0, i32 1}
  !1 = !{i32 2, !"Debug Info Version", i32 3}
  !2 = distinct !DICompileUnit(language: DW_LANG_Go, file: !3, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "tail.go", directory: "/")
  !4 = distinct !DISubprogram(name: "barrier_succ_tail", scope: !3, file: !3, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !2)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !{!"go1.22.12"}
  !8 = distinct !DISubprogram(name: "barrier_succ_load_tail", scope: !3, file: !3, line: 10, type: !5, spFlags: DISPFlagDefinition, unit: !2)
...
---
name: barrier_succ_tail
tracksRegLiveness: true
frameInfo:
  stackSize: 0
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $rax, $rdi, $rdx, $rsi, $r10, $r15
    CMP32mi $rip, 1, $noreg, target-flags(x86-gotpcrel) @runtime.writeBarrier, $noreg, 0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
  bb.1:
    successors: %bb.2
    liveins: $rax, $rdi, $rdx, $rsi, $r10, $r15
    CALL64pcrel32 target-flags(x86-plt) @runtime.gcWriteBarrier2, csr_64_allregs_nor11_nosse, implicit $rsp, implicit-def $rsp, implicit-def $r11
    MOV64mr renamable $r11, 1, $noreg, 0, $noreg, renamable $rdi
    renamable $r9 = MOV64rm renamable $rsi, 1, renamable $r10, 0, $noreg
    MOV64mr killed renamable $r11, 1, $noreg, 8, $noreg, killed renamable $r9
  bb.2:
    successors: %bb.3, %bb.4
    liveins: $rax, $rdi, $rdx, $rsi, $r10, $r15
    renamable $r9 = LEA64r renamable $rdx, 1, renamable $r15, 0, $noreg
    MOV64mr renamable $rsi, 1, renamable $r10, 0, $noreg, killed renamable $rdi
    CMP64ri32 renamable $r9, 2147483647, implicit-def $eflags
    JCC_1 %bb.4, 13, implicit $eflags
  bb.3:
    successors: %bb.4
    liveins: $rax
    $rax = INC64r killed $rax, implicit-def dead $eflags
  bb.4:
    RET 0
...
---
name: barrier_succ_load_tail
tracksRegLiveness: true
frameInfo:
  stackSize: 0
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $rax, $rdi, $rsi, $r10
    CMP32mi $rip, 1, $noreg, target-flags(x86-gotpcrel) @runtime.writeBarrier, $noreg, 0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
  bb.1:
    successors: %bb.2
    liveins: $rax, $rdi, $rsi, $r10
    CALL64pcrel32 target-flags(x86-plt) @runtime.gcWriteBarrier2, csr_64_allregs_nor11_nosse, implicit $rsp, implicit-def $rsp, implicit-def $r11
    MOV64mr renamable $r11, 1, $noreg, 0, $noreg, renamable $rdi
    renamable $r9 = MOV64rm renamable $rsi, 1, renamable $r10, 0, $noreg
    MOV64mr killed renamable $r11, 1, $noreg, 8, $noreg, killed renamable $r9
  bb.2:
    successors: %bb.3, %bb.4
    liveins: $rax, $rdi, $rsi, $r10
    MOV64mr renamable $rsi, 1, renamable $r10, 0, $noreg, killed renamable $rdi
    CMP64mi8 renamable $rsi, 1, $noreg, 0, $noreg, 0, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
  bb.3:
    successors: %bb.4
    liveins: $rax
    $rax = INC64r killed $rax, implicit-def dead $eflags
  bb.4:
    RET 0
...
