; NOTE: Assertions have been generated by hand.
; RUN: llc -mtriple=x86_64-linux-gnu -O3 < %s | FileCheck %s

; LS1c negative controls. The narrowed tail-duplication guard only matches the
; lockSlow shape (an in-loop, >=3-predecessor atomic-RMW block with a dominant
; in-loop failure edge). An ordinary atomic fast-path block with two
; predecessors, and a plain non-atomic block, must still be tail-duplicated,
; proving the guard does not blanket-disable duplication.

; Atomic fast path: the RMW block R has two predecessors and no dominant
; in-loop edge, so it does not match the guard and block placement duplicates
; it (two locked xadd sites).
define cc 113 void @fastpath(ptr %p, i1 %flag, i32 %v) gc "go" !go.caller.args.area !0 {
entry:
  br label %L

L:
  br i1 %flag, label %A, label %B2, !prof !1

A:
  %va = add i32 %v, 1
  br label %R

B2:
  %vb = add i32 %v, 2
  br label %R

R:
  %r = phi i32 [ %va, %A ], [ %vb, %B2 ]
  %old2 = atomicrmw add ptr %p, i32 %r seq_cst, align 4
  %done = icmp eq i32 %old2, 100
  br i1 %done, label %exit1, label %L, !prof !2

exit1:
  ret void
}

; Non-atomic twin of the same trellis. The guard never fires for plain memory
; and block placement tail-duplicates the shared store block (two stores).
define cc 113 void @plainloop(ptr %p, i1 %flag, i32 %v) gc "go" !go.caller.args.area !0 {
entry:
  br label %L2

L2:
  br i1 %flag, label %A2, label %B3, !prof !1

A2:
  %va2 = add i32 %v, 1
  br label %R2

B3:
  %vb2 = add i32 %v, 2
  br label %R2

R2:
  %r2 = phi i32 [ %va2, %A2 ], [ %vb2, %B3 ]
  store i32 %r2, ptr %p, align 4
  %done2 = icmp eq i32 %r2, 100
  br i1 %done2, label %exit2, label %L2, !prof !2

exit2:
  ret void
}

!0 = !{i64 0, i64 0}
!1 = !{!"branch_weights", i32 1, i32 1}
!2 = !{!"branch_weights", i32 1, i32 1}

; CHECK-LABEL: fastpath:
; CHECK: lock
; CHECK-SAME: xadd
; CHECK: lock
; CHECK-SAME: xadd
; CHECK-LABEL: plainloop:
; CHECK: movl{{.*}}(%{{[a-z0-9]+}})
; CHECK: movl{{.*}}(%{{[a-z0-9]+}})
